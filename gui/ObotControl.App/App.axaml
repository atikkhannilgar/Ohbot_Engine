<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ObotControl.App.App"
             RequestedThemeVariant="Dark">

  <!-- All colours, sizes and control styling live in Styles/. Views reference them by name
       and never hardcode a hex value, so the app can be re-themed from one file. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ObotControl.App/Styles/Tokens.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ObotControl.App/Styles/Controls.axaml"/>
  </Application.Styles>

</Application>
